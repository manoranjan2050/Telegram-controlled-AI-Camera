# TelegramP4 — default sdkconfig values checked into Git.
#
# This file must NEVER contain secrets (Wi-Fi password, Telegram bot token, chat
# IDs). Those live only in the local, gitignored `sdkconfig` generated by
# `idf.py menuconfig`. See docs/configuration.md.
#
# Target is set explicitly via `idf.py set-target esp32p4` (not hardcoded here) so
# this file stays reusable if a second board target is added later.

# Phase 0: default log verbosity. Individual module log levels can be tuned later
# without touching this file (see docs/configuration.md "Debug" section).
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# Custom partition table with two OTA app slots reserved from the start.
# See partitions/partitions.csv.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions/partitions.csv"

# PSRAM/camera/video/AI-specific sdkconfig options are added in Phase 5/14 once the
# exact FireBeetle 2 ESP32-P4 memory configuration is verified (see docs/hardware.md)
# rather than guessed here.
