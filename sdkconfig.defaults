# TelegramP4 — default sdkconfig values checked into Git.
#
# This file must NEVER contain secrets (Wi-Fi password, Telegram bot token, chat
# IDs). Those live only in the local, gitignored `sdkconfig` generated by
# `idf.py menuconfig`. See docs/configuration.md.
#
# Target is set explicitly via `idf.py set-target esp32p4` (not hardcoded here) so
# this file stays reusable if a second board target is added later.

# Phase 0: default log verbosity. Individual module log levels can be tuned later
# without touching this file (see docs/configuration.md "Debug" section).
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# Custom partition table with two OTA app slots reserved from the start.
# See partitions/partitions.csv.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions/partitions.csv"

# Confirmed 2026-09-07 from DFRobot's own DFR1172 wiki spec table and the
# boot log ("Detected size(16384k)..."): this board's chip variant is
# ESP32-P4NRW32 with 16MB flash and 32MB in-package PSRAM.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# PSRAM itself inits fine when enabled ("esp_psram: Found 32MB PSRAM device",
# "SPI SRAM memory test OK") - but with CONFIG_SPIRAM=y, ESP-Hosted's very
# early boot-time static task creation (before app_main even runs) hits
# `assert failed: xTaskCreateStaticPinnedToCore ...
# xPortCheckValidTCBMem(pxTaskBuffer)` and boot-loops. Root cause not yet
# understood (a heap-layout side effect of adding the PSRAM pool, most
# likely) - needs real investigation, not a guessed Kconfig toggle. Left
# disabled for now so WiFi/Telegram/SD stay on the last known-good, tested
# configuration. Camera JPEG capture needs PSRAM for frame buffers
# (roughly 1.28MB for two 800x800 RAW8 buffers, more than the ~768KB
# internal L2MEM has room for) so this must be resolved before /photo can
# actually produce an image - see CLAUDE.md and docs/hardware.md.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y

# Phase 1: ESP32-P4 has no native WiFi radio - connectivity is provided by the
# onboard ESP32-C6 co-processor, reached through the esp_wifi_remote managed
# component (see main/idf_component.yml) instead of the classic on-chip
# esp_wifi driver. This is confirmed from ESP-IDF's own official examples
# (examples/protocols/mqtt/tcp/sdkconfig.ci.p4_wifi) and Kconfig
# (components/esp_wifi/Kconfig), not guessed. The transport between P4 and C6
# (SDIO vs SPI) on this specific board is still unconfirmed - see
# docs/hardware.md.
CONFIG_ESP_WIFI_REMOTE_LIBRARY_HOSTED=y

# Phase 2: Telegram HTTPS client uses the ESP-IDF bundled root CA certificate
# store for TLS validation instead of pinning Telegram's certificate directly
# (avoids breakage if Telegram rotates their cert/CA). Certificate validation is
# never disabled — see docs/security.md.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y

# Phase 5: real camera sensor, identified 2026-09-07 as OV5647 (the installed
# module is a Raspberry Pi Camera Module v1.3). Officially supported by
# Espressif's esp_cam_sensor component over MIPI-CSI on ESP32-P4.
CONFIG_CAMERA_OV5647=y

# Confirmed 2026-09-09 on real hardware: esp_video only registers the JPEG
# M2M encoder device (/dev/video10, ESP_VIDEO_JPEG_DEVICE_NAME) when this
# option is on - it defaults to "n" in the espressif/esp_video managed
# component's own Kconfig. Without it, telegramp4_camera's
# open(ESP_VIDEO_JPEG_DEVICE_NAME) always fails even though the MIPI-CSI
# capture device and the sensor itself work fine.
CONFIG_ESP_VIDEO_ENABLE_HW_JPEG_ENC_VIDEO_DEVICE=y

# Same pattern, for video (Phase 9): esp_video only registers the H.264 M2M
# encoder device (/dev/video11, ESP_VIDEO_H264_DEVICE_NAME) when this option
# is on - it also defaults to "n". Without it, telegramp4_video's
# open(ESP_VIDEO_H264_DEVICE_NAME) always fails.
CONFIG_ESP_VIDEO_ENABLE_HW_H264_VIDEO_DEVICE=y

# Confirmed 2026-09-11 on real hardware: photos and video were both coming
# out noticeably dark/underexposed. Root cause - this option (default "n")
# gates Espressif's entire closed-loop 3A controller (a dedicated "isp_task"
# that runs the IPA auto-exposure/auto-gain/auto-white-balance algorithms
# and feeds results back to the sensor). With it off, the camera runs on
# the sensor's raw power-on register defaults with *no* active exposure
# control at all. Enabling it starts the controller automatically as part
# of the existing esp_video_init() call - no application code change
# needed. See components/telegramp4_camera/telegramp4_camera.c and
# docs/lessons/05-camera.md.
CONFIG_ESP_VIDEO_ENABLE_ISP_PIPELINE_CONTROLLER=y

# Confirmed 2026-09-10 on real hardware: CONFIG_VFS_MAX_COUNT (default 8) is a
# fixed-size table of *registered VFS backends* (not open file descriptors) -
# console/stdio + eventfd take a few slots on their own, esp_video registers
# one entry per device node (/dev/video0 AND /dev/video10 = 2), and the SD
# card's FATFS mount takes one more. Once the camera+SD init-order fix (see
# main/app_main.cpp) let both actually succeed at boot for the first time,
# the table filled up before lwip's own socket VFS could register when WiFi
# started, aborting with ESP_ERR_NO_MEM. Raised with headroom to spare -
# bumped again to the Kconfig maximum (20) once video mode (Phase 9) added
# a third /dev/videoN device node (/dev/video11, H.264) to the same table.
CONFIG_VFS_MAX_COUNT=20

# Confirmed 2026-09-09 on real hardware, as the second half of the
# CONFIG_SPIRAM boot-loop fix (see main/freertos_static_mem.c for the first
# half, IDLE task memory). ESP-IDF's main_task is created dynamically
# (xTaskCreatePinnedToCore, components/freertos/app_startup.c) with the
# default 3584-byte stack, allocated from the heap with plain
# MALLOC_CAP_INTERNAL. With CONFIG_SPIRAM=y the internal-SRAM heap can be
# fragmented enough at boot for this to land in the ESP32-P4's small 8KB TCM
# region instead of ordinary SRAM, which later fails
# esp_task_stack_is_sane_cache_disabled() (cache_utils.c) the first time a
# flash operation needs to run from main_task's context - asserting and
# rebooting. TCM is exactly 8KB (0x2000 bytes), so any single allocation
# above that size structurally cannot be satisfied by it: raising the main
# task's stack past that threshold guarantees it always comes from L2MEM.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
