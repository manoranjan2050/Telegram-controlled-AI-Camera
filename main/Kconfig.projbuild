menu "TelegramP4 Configuration"

    menu "WiFi"

        config TELEGRAMP4_WIFI_SSID
            string "WiFi SSID"
            default ""
            help
                Network SSID to connect to. Stored only in your local sdkconfig
                (gitignored) — never commit a real value.

        config TELEGRAMP4_WIFI_PASSWORD
            string "WiFi Password"
            default ""
            help
                Network password (WPA2-PSK). Stored only in your local sdkconfig
                (gitignored) — never commit a real value, never logged by the
                firmware.

        config TELEGRAMP4_WIFI_CONNECT_TIMEOUT_MS
            int "WiFi initial connect timeout (ms)"
            default 15000
            help
                How long app_main waits for the first successful connection
                before giving up and continuing boot without WiFi. Reconnection
                attempts continue in the background regardless.

    endmenu

    menu "Telegram"

        config TELEGRAMP4_TELEGRAM_BOT_TOKEN
            string "Telegram Bot Token"
            default "123456789:REPLACE_WITH_YOUR_BOT_TOKEN"
            help
                Get this from @BotFather (see docs/telegram-bot-setup.md). Stored
                only in your local sdkconfig (gitignored) — never commit a real
                value, never logged by the firmware.

        config TELEGRAMP4_TELEGRAM_ALLOWED_CHAT_IDS
            string "Allowed Telegram Chat IDs (comma-separated)"
            default ""
            help
                Only these chat IDs may control the device. Everyone else gets
                "Access denied." with no further detail. See
                docs/telegram-bot-setup.md for how to find your chat ID. Leave
                empty during setup and every command will be denied until you
                add your ID.

    endmenu

    menu "Camera"

        config TELEGRAMP4_CAMERA_JPEG_QUALITY
            int "JPEG quality (0-63, lower = higher quality)"
            default 12
            range 0 63

        config TELEGRAMP4_CAMERA_FRAME_WIDTH
            int "Capture frame width"
            default 800

        config TELEGRAMP4_CAMERA_FRAME_HEIGHT
            int "Capture frame height"
            default 600

        comment "Pins below confirmed from DFRobot DFR1172 schematic (2026-09-07): SCL=8/SDA=7 wired to the CSI connector's I2C lines; the connector has no reset/pwdn/xclk signal at all (sensor is MIPI-clocked), hence reset/pwdn/xclk default -1 (unused)."

        config TELEGRAMP4_CAMERA_SCCB_I2C_PORT
            int "SCCB (I2C) port number"
            default 0

        config TELEGRAMP4_CAMERA_SCCB_SCL_PIN
            int "SCCB (I2C) SCL pin"
            default 8

        config TELEGRAMP4_CAMERA_SCCB_SDA_PIN
            int "SCCB (I2C) SDA pin"
            default 7

        config TELEGRAMP4_CAMERA_SCCB_I2C_FREQ
            int "SCCB (I2C) frequency (Hz)"
            default 100000

        config TELEGRAMP4_CAMERA_RESET_PIN
            int "Camera sensor reset pin (-1 = not connected)"
            default -1

        config TELEGRAMP4_CAMERA_PWDN_PIN
            int "Camera sensor power-down pin (-1 = not connected)"
            default -1

        config TELEGRAMP4_CAMERA_XCLK_PIN
            int "Camera sensor XCLK pin (-1 = not driven by host)"
            default -1

        config TELEGRAMP4_CAMERA_XCLK_FREQ
            int "Camera sensor XCLK frequency (Hz), if XCLK_PIN >= 0"
            default 24000000
            depends on TELEGRAMP4_CAMERA_XCLK_PIN >= 0

    endmenu

    menu "Storage"

        config TELEGRAMP4_STORAGE_MAX_DOWNLOAD_SIZE_KB
            int "Max size accepted for files downloaded from Telegram (KB)"
            default 5120
            help
                Files larger than this (received photos/voice via getFile) are
                rejected rather than downloaded. Prevents a malicious or
                oversized upload from filling the SD card.

    endmenu

    menu "Video"

        config TELEGRAMP4_VIDEO_MIN_DURATION_S
            int "Minimum recording length (seconds)"
            default 1

        config TELEGRAMP4_VIDEO_DEFAULT_DURATION_S
            int "Default recording length (seconds)"
            default 10

        config TELEGRAMP4_VIDEO_MAX_DURATION_S
            int "Maximum recording length (seconds)"
            default 60

    endmenu

    menu "Audio"

        config TELEGRAMP4_AUDIO_MIN_DURATION_S
            int "Minimum recording length (seconds)"
            default 1

        config TELEGRAMP4_AUDIO_DEFAULT_DURATION_S
            int "Default recording length (seconds)"
            default 10

        config TELEGRAMP4_AUDIO_MAX_DURATION_S
            int "Maximum recording length (seconds)"
            default 60

    endmenu

    menu "Speech-to-Text"

        config TELEGRAMP4_STT_ENABLED
            bool "Enable voice command processing (cloud STT)"
            default n
            help
                Sends received voice notes to an external speech-to-text
                service (currently OpenAI's audio transcription API) so
                spoken commands like "take a photo" can trigger the matching
                /command. This uses your own API key, costs money per call,
                and adds network latency - disabled by default. See
                docs/lessons/12-ai.md.

        config TELEGRAMP4_STT_API_KEY
            string "STT provider API key"
            default "sk-REPLACE_WITH_YOUR_API_KEY"
            depends on TELEGRAMP4_STT_ENABLED
            help
                Stored only in your local sdkconfig (gitignored) - never
                commit a real key, never logged by the firmware.

    endmenu

    menu "AI"

        config TELEGRAMP4_AI_ENABLED
            bool "Enable on-device AI object detection"
            default n
            help
                Compile/config-time switch for AI features (/ai command,
                motion+AI alerts). Off by default until a model and inference
                framework have been verified on real hardware - see
                docs/hardware.md and docs/lessons/12-ai.md.

    endmenu

    menu "Motion"

        config TELEGRAMP4_MOTION_ENABLED
            bool "Enable PIR motion detection"
            default n

        config TELEGRAMP4_MOTION_PIR_GPIO
            int "PIR sensor GPIO"
            default -1
            depends on TELEGRAMP4_MOTION_ENABLED
            help
                -1 means unset. You must set this to a GPIO you've confirmed
                is safe/available on your board before enabling motion
                detection - see docs/hardware.md. Assumes an active-high PIR
                output (e.g. HC-SR501-style); verify against your module.

        config TELEGRAMP4_MOTION_ALERT_COOLDOWN_S
            int "Minimum seconds between motion Telegram alerts"
            default 30

    endmenu

    menu "GPIO"

        config TELEGRAMP4_GPIO_WHITELIST
            string "Whitelisted GPIOs for /gpio control (comma-separated)"
            default ""
            help
                Only these pins can be controlled via /gpio. Empty means no
                pins are exposed. Never add a pin here without confirming
                it's safe to drive as a generic output on your board.

    endmenu

    menu "Display"

        config TELEGRAMP4_DISPLAY_ENABLED
            bool "Enable optional MIPI-DSI status display"
            default n
            help
                Compile-time optional so the firmware works identically with
                no display attached. Panel/driver unverified for this board -
                see docs/hardware.md.

    endmenu

    menu "OTA"

        config TELEGRAMP4_OTA_ENABLED
            bool "Enable OTA firmware updates via /ota <url>"
            default n
            help
                Flashing arbitrary firmware from a URL is powerful - off by
                default. The two-OTA-slot partition table is always present
                (Phase 0) regardless of this setting.

    endmenu

    # Phase 22+ adds more submenus/options here as each subsystem's Kconfig
    # options are introduced. See docs/configuration.md for the full option
    # reference and which phase adds each one.

endmenu
